erDiagram
    %% ==========================================
    %% H7: STAFF & PERSONNEL SYSTEM (3NF)
    %% ==========================================
    departments ||--o{ employees : "employs"
    positions ||--o{ employees : "assigns"
    titles ||--o{ employees : "prefixes"
    genders ||--o{ employees : "classifies"
    employees ||--o{ medical_licenses : "holds"
    employees ||--o{ work_shifts : "scheduled"
    shift_types ||--o{ work_shifts : "defines"
    employees ||--o{ attendance : "logs"
    employees ||--o{ leave_requests : "submits"
    leave_types ||--o{ leave_requests : "categorizes"
    employees ||--o{ employee_contracts : "signs"
    employees ||--o{ payroll : "receives"
    payroll ||--o{ payroll_items : "contains"
    employees ||--o{ emergency_contacts : "contacts"
    employees ||--o| users : "authenticates"
    roles ||--o{ users : "grants"
    employees ||--o{ employee_specialties : "specializes"
    specialties ||--o{ employee_specialties : "certified"
    employees ||--o{ doctors : "bridged_as"

    %% ==========================================
    %% H6: INPATIENT & WARDS SYSTEM
    %% ==========================================
    departments ||--o{ wards : "manages"
    wards ||--o{ beds : "contains"
    patients ||--o{ admissions : "admitted"
    beds ||--o{ admissions : "occupies"
    admissions ||--o{ bed_transfers : "tracks"

    %% ==========================================
    %% CROSS-MODULE INTEGRATION (H7 <--> H6)
    %% ==========================================
    doctors ||--o{ admissions : "attending_physician (attending_doctor_id)"
    employees ||--o{ wards : "ward_head_nurse (head_nurse_id)"

    %% ==========================================
    %% ENTITY DEFINITIONS
    %% ==========================================
    employees {
        string employee_id PK
        string first_name
        string last_name
        string department_id FK
        int position_id FK
        string status
        string email
    }

    doctors {
        string doctor_id PK
        string employee_id FK
        string department_id FK
        string doctor_name
        numeric salary_thb
    }

    departments {
        string department_id PK
        string department_name
        string branch_id FK
        string department_head_id FK
    }

    wards {
        string ward_id PK
        string department_id FK
        string ward_name
        string ward_type
        int bed_capacity
        string head_nurse_id FK
    }

    beds {
        string bed_id PK
        string ward_id FK
        string room_number
        string bed_type
        string bed_status
    }

    admissions {
        string admission_id PK
        string patient_id FK
        string attending_doctor_id FK
        string bed_id FK
        timestamp admission_date
        timestamp discharge_date
        string admission_type
        string discharge_status
    }

    medical_licenses {
        int license_id PK
        string employee_id FK
        string license_number
        date expiry_date
        string status
    }

    work_shifts {
        int shift_id PK
        string employee_id FK
        date shift_date
        int shift_type_id FK
    }

    payroll {
        int payroll_id PK
        string employee_id FK
        date pay_period_start
        date pay_period_end
        numeric net_amount
    }
